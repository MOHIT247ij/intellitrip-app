# IntelliTrip Frontend — public configuration only.
# NEVER put secret keys here (Gemini, payment secrets, DB passwords) —
# anything in a Vite .env with the VITE_ prefix is bundled into the
# browser JS and is publicly visible.

VITE_API_URL=http://localhost:5000/api

# Optional: used for the interactive map (Explore / Trip Detail pages).
# Client-side Maps JS API keys are meant to be restricted by HTTP
# referrer in the Google Cloud Console, not kept secret.
VITE_GOOGLE_MAPS_API_KEY=
