# =====================================================================
# IntelliTrip Backend — Environment Configuration
# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` file.
# =====================================================================

# ---- Database (MySQL 8) -------------------------------------------
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:YOUR_PASSWORD@localhost:3306/intellitrip"

# ---- Server ----------------------------------------------------------
NODE_ENV="development"
PORT=5000
CLIENT_URL="http://localhost:5173"

# ---- Auth --------------------------------------------------------
JWT_SECRET="some-long-random-string"
JWT_EXPIRES_IN="7d"

# Development OTP mode: when true, OTPs are logged to the backend
# console (and returned in the API response) instead of being sent
# by a real Email provider. Keep this ON for local college demo.
OTP_DEV_MODE="true"
OTP_EXPIRY_MINUTES=10

# ---- Google Gemini (AI itinerary generation) --------------------
# Get a key from https://aistudio.google.com/app/apikey
# Leave blank to run the AI planner in a deterministic template
# fallback mode (still returns valid structured itineraries).
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# ---- Google Maps (frontend also needs a copy in frontend/.env) --
GOOGLE_MAPS_API_KEY=""

# ---- OpenWeather ---------------------------------------------------
OPENWEATHER_API_KEY=""
WEATHER_PROVIDER="mock"   # "openweather" | "mock"

# ---- Booking providers --------------------------------------------
# "mock"     -> deterministic demo hotel/flight/cab/experience inventory (default)
# "rapidapi" -> real hotel + flight search via RapidAPI (falls back to
#               mock automatically if the API call fails). Cabs and
#               Experiences always stay mock — see README.
# Get a free key at https://rapidapi.com/hub (subscribe to the
# "Booking.com" API and the "Skyscanner44" API on the free tier).
BOOKING_PROVIDER="mock"
RAPIDAPI_KEY=""
RAPIDAPI_HOTELS_HOST="booking-com.p.rapidapi.com"
RAPIDAPI_FLIGHTS_HOST="skyscanner44.p.rapidapi.com"

# ---- Payments (UPI / payment gateway architecture) -----------------
# "mock"     -> simulated UPI intent + simulated verify (default, no keys needed)
# "razorpay" -> real Razorpay TEST MODE order + Checkout popup + signature verify
# Get TEST keys from https://dashboard.razorpay.com/app/keys (toggle
# "Test Mode" in the dashboard first) — no real money moves in test mode.
PAYMENT_PROVIDER="mock"
PAYMENT_API_KEY=""
UPI_PAYEE_VPA="intellitrip@upi"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# ---- Third-party notifications (real OTP delivery) -----------------
EMAIL_API_KEY=""

# Email OTP: "mock" (console log, default) | "gmail" (real send via Nodemailer + Gmail SMTP)
# 1. Turn on 2-Step Verification on the Gmail account: https://myaccount.google.com/security
# 2. Create an App Password: https://myaccount.google.com/apppasswords
# 3. Use that 16-character app password below — NOT your normal Gmail password.
EMAIL_PROVIDER="mock"
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
EMAIL_FROM_NAME="IntelliTrip"

# ---- Rate limiting --------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
