{
  "name": "intellitrip-backend",
  "version": "1.0.0",
  "description": "IntelliTrip backend - Node.js/Express/Prisma/MySQL API with Gemini AI + RAG powered itinerary planning",
  "main": "src/server.js",
  "type": "commonjs",
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
